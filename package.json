{
  "name": "electron-vue-vite-boilerplate",
  "version": "2.3.7",
  "packageManager": "pnpm@10.29.2",
  "description": "Electron Vue Vite Boilerplate for you next project",
  "author": {
    "name": "Anton Reshetov",
    "email": "reshetov.art@gmail.com"
  },
  "license": "MIT",
  "repository": "https://github.com/antonreshetov/electron-vue-vite-boilerplate",
  "main": "build/main/index.js",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=10.29.2 <11"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"npm:dev:main\" \"npm:dev:start\"",
    "dev:main": "nodemon",
    "dev:start": "wait-on --timeout 60000 http-get://127.0.0.1:5173 build/main/index.js && cross-env NODE_ENV=development electronmon .",
    "build": "vite build && npm run build:main && electron-builder",
    "build:mac": "vite build && npm run build:main && electron-builder --mac --x64 --arm64",
    "build:mac:local": "vite build && npm run build:main && electron-builder --mac -c.mac.notarize=false -c.mac.identity=null --publish never",
    "build:win": "vite build && npm run build:main && electron-builder --win --x64",
    "build:linux": "vite build && npm run build:main && electron-builder --linux --x64",
    "build:all": "vite build && npm run build:main && npm run build:mac && npm run build:win && npm run build:linux",
    "build:main": "tsc -p tsconfig.main.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "bumpp -c 'build: release v' -t",
    "changelog": "conventional-changelog -n changelog.config.js -i CHANGELOG.md -s -r 0",
    "rebuild": "electron-rebuild",
    "prepare": "simple-git-hooks && npm run rebuild",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "pnpm build:main && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "bumpp": "^12.3.0",
    "concurrently": "^10.0.5",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "eslint": "^10.11.0",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12",
    "wait-on": "^9.5.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "simple-git-hooks"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "electronmon": {
    "patterns": [
      "!src/**/*",
      "!scripts/**/*",
      "build/main/**/*"
    ]
  }
}
